      "record": null,
      "returns": [
        "ts",
        "author",
        "text"
      ],
      "roles": [
        "analyst",
        "senior_reviewer",
        "support",
        "support_lead"
      ],
      "rules": []
    },
    "slack.post_message": {
      "audit": {
        "mask_inputs": [],
        "min_retention_days": 365,
        "required": true
      },
      "blocked": false,
      "changes_data": true,
      "connector": "slack",
      "description": "Post a message to a channel.",
      "masked_fields": {},
      "params": {
        "channel": {
          "required": true,
          "type": "enum",
          "values": [
            "compliance",
            "support",
            "general"
          ]
        },
        "text": {
          "required": true,
          "type": "string"
        }
      },
      "record": null,
      "returns": [],
      "roles": [
        "analyst",
        "senior_reviewer",
        "support",
        "support_lead"
      ],
      "rules": []
    }
