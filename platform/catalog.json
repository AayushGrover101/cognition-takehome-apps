{
  "connectors": {
    "email": {
      "description": "Send email to any address. Blocked by default.",
      "group": "blocked",
      "title": "Outbound email"
    },
    "exchange_rates": {
      "description": "Public currency rates from an outside provider.",
      "group": "external",
      "title": "Exchange rates"
    },
    "kyc": {
      "description": "Identity-verification cases from the compliance database.",
      "group": "internal",
      "title": "KYC cases"
    },
    "refunds": {
      "description": "Refund requests from the payments database.",
      "group": "internal",
      "title": "Refunds"
    },
    "slack": {
      "description": "Company Slack workspace. An outside service.",
      "group": "external",
      "title": "Slack"
    }
  },
  "operations": {
    "email.send_email": {
      "audit": {
        "mask_inputs": [],
        "min_retention_days": 365,
        "required": true
      },
      "blocked": false,
      "changes_data": true,
      "connector": "email",
      "description": "Send an email to any address.",
      "masked_fields": {},
      "params": {
        "body": {
          "required": true,
          "type": "string"
        },
        "subject": {
          "required": true,
          "type": "string"
        },
        "to": {
          "required": true,
          "type": "string"
        }
      },
      "record": null,
      "returns": [],
      "roles": [
        "analyst",
        "senior_reviewer",
        "support",
        "support_lead"
      ],
      "rules": []
    },
    "exchange_rates.get_rate": {
      "audit": {
        "mask_inputs": [],
        "min_retention_days": 30,
        "required": false
      },
      "blocked": false,
      "changes_data": false,
      "connector": "exchange_rates",
      "description": "Get today's rate from a currency to USD.",
      "masked_fields": {},
      "params": {
        "currency": {
          "required": true,
          "type": "enum",
          "values": [
            "EUR",
            "GBP",
            "CAD",
            "JPY",
            "USD"
          ]
        }
      },
      "record": null,
      "returns": [
        "currency",
        "usd_rate",
        "as_of"
      ],
      "roles": [
        "analyst",
        "senior_reviewer",
        "support",
        "support_lead"
      ],
      "rules": []
    },
    "kyc.decide_case": {
      "audit": {
        "mask_inputs": [],
        "min_retention_days": 2555,
        "required": true
      },
      "blocked": false,
      "changes_data": true,
      "connector": "kyc",
      "description": "Approve or reject a KYC case.",
      "masked_fields": {},
      "params": {
        "case_id": {
          "required": true,
          "type": "string"
        },
        "decision": {
          "required": true,
          "type": "enum",
          "values": [
            "approve",
            "reject"
          ]
        },
        "reason": {
          "type": "string"
        }
      },
      "record": "case_id",
      "returns": [],
      "roles": [
        "analyst",
        "senior_reviewer"
      ],
      "rules": [
        "High-risk and escalated cases can only be decided by a senior reviewer.",
        "A case that is already approved or rejected cannot be decided again."
      ]
    },
    "kyc.escalate_case": {
      "audit": {
        "mask_inputs": [],
        "min_retention_days": 2555,
        "required": true
      },
      "blocked": false,
      "changes_data": true,
      "connector": "kyc",
      "description": "Escalate a KYC case to a senior reviewer.",
      "masked_fields": {},
      "params": {
        "case_id": {
          "required": true,
          "type": "string"
        }
      },
      "record": "case_id",
      "returns": [],
      "roles": [
        "analyst",
        "senior_reviewer"
      ],
      "rules": []
    },
    "kyc.get_case": {
      "audit": {
        "mask_inputs": [],
        "min_retention_days": 90,
        "required": true
      },
      "blocked": false,
      "changes_data": false,
      "connector": "kyc",
      "description": "Get one KYC case.",
      "masked_fields": {
        "date_of_birth": [
          "senior_reviewer"
        ],
        "tax_id": [
          "senior_reviewer"
        ]
      },
      "params": {
        "case_id": {
          "required": true,
          "type": "string"
        }
      },
      "record": "case_id",
      "returns": [
        "id",
        "name",
        "country",
        "risk",
        "status",
        "tax_id",
        "date_of_birth",
        "submitted_at",
        "decided_by",
        "flags"
      ],
      "roles": [
        "analyst",
        "senior_reviewer"
      ],
      "rules": []
    },
    "kyc.list_cases": {
      "audit": {
        "mask_inputs": [],
        "min_retention_days": 90,
        "required": true
      },
      "blocked": false,
      "changes_data": false,
      "connector": "kyc",
      "description": "List KYC cases, optionally filtered by status.",
      "masked_fields": {
        "date_of_birth": [
          "senior_reviewer"
        ],
        "tax_id": [
          "senior_reviewer"
        ]
      },
      "params": {
        "status": {
          "type": "enum",
          "values": [
            "new",
            "in_review",
            "escalated",
            "approved",
            "rejected"
          ]
        }
      },
      "record": null,
      "returns": [
        "id",
        "name",
        "country",
        "risk",
        "status",
        "tax_id",
        "date_of_birth",
        "submitted_at",
        "decided_by"
      ],
      "roles": [
        "analyst",
        "senior_reviewer"
      ],
      "rules": []
    },
    "refunds.decline_refund": {
      "audit": {
        "mask_inputs": [],
        "min_retention_days": 2555,
        "required": true
      },
      "blocked": false,
      "changes_data": true,
      "connector": "refunds",
      "description": "Decline a pending refund.",
      "masked_fields": {},
      "params": {
        "reason": {
          "required": true,
          "type": "string"
        },
        "refund_id": {
          "required": true,
          "type": "string"
        }
      },
      "record": "refund_id",
      "returns": [],
      "roles": [
        "support",
        "support_lead"
      ],
      "rules": [
        "Only a pending refund can be declined."
      ]
    },
    "refunds.issue_refund": {
      "audit": {
        "mask_inputs": [],
        "min_retention_days": 2555,
        "required": true
      },
      "blocked": false,
      "changes_data": true,
      "connector": "refunds",
      "description": "Issue a pending refund.",
      "masked_fields": {},
      "params": {
        "refund_id": {
          "required": true,
          "type": "string"
        }
      },
      "record": "refund_id",
      "returns": [],
      "roles": [
        "support",
        "support_lead"
      ],
      "rules": [
        "Refunds over 500 can only be issued by a support lead.",
        "Only a pending refund can be issued."
      ]
    },
    "refunds.list_refunds": {
      "audit": {
        "mask_inputs": [],
        "min_retention_days": 90,
        "required": true
      },
      "blocked": false,
      "changes_data": false,
      "connector": "refunds",
      "description": "List refund requests, optionally filtered by status.",
      "masked_fields": {
        "email": [
          "support_lead"
        ]
      },
      "params": {
        "status": {
          "type": "enum",
          "values": [
            "pending",
            "issued",
            "declined"
          ]
        }
      },
      "record": null,
      "returns": [
        "id",
        "customer",
        "email",
        "amount",
        "currency",
        "reason",
        "status",
        "requested_at",
        "handled_by"
      ],
      "roles": [
        "support",
        "support_lead"
      ],
      "rules": []
    },
    "slack.list_messages": {
      "audit": {
        "mask_inputs": [],
        "min_retention_days": 30,
        "required": false
      },
      "blocked": false,
      "changes_data": false,
      "connector": "slack",
      "description": "Read recent messages in a channel.",
      "masked_fields": {},
      "params": {
        "channel": {
          "required": true,
          "type": "enum",
          "values": [
            "compliance",
            "support",
            "general"
          ]
        }
